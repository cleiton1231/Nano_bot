[Unit]
Description=llama-server — reranker (nanobot local stack, port 8081)
After=network.target
Wants=network.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=nanobot-svc
Group=nanobot-svc
WorkingDirectory=/home/nanobot-svc
ExecStart=/usr/local/bin/llama-server \
  --model /home/cleiton/local/models/qwen3-reranker-0.6b-q8/qwen3-reranker-0.6b-q8_0.gguf \
  --reranking \
  --pooling rank \
  --host 127.0.0.1 \
  --port 8081 \
  --ctx-size 8192
Restart=on-failure
RestartSec=10
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
